# Application
APP_NAME="AI Virtual Try-On Platform"
DEBUG=false
ENVIRONMENT=development

# Security — CHANGE THIS IN PRODUCTION
SECRET_KEY=replace_with_a_strong_random_secret_key_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=virtual_tryon

# CORS (comma separated)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Storage paths (relative to backend/)
STORAGE_PATH=../storage
UPLOADS_PATH=../storage/uploads
GENERATED_PATH=../storage/generated
PRODUCTS_PATH=../storage/products
MAX_UPLOAD_SIZE_MB=10

# AI Model Configuration
# Options: idm_vton | demo
# Use 'demo' if no GPU is available — shows proper error instead of crashing
AI_MODEL=demo
AI_MODEL_DEVICE=cpu

# HuggingFace (required for IDM-VTON model download)
# Create account at https://huggingface.co and accept IDM-VTON model terms
HUGGINGFACE_TOKEN=

# Rate limiting
TRYON_RATE_LIMIT=5
